            "key": "WM        ",
            "keyColor": "blue"
        },
        {
            "type": "cpu",
            "key": "CPU       ",
            "keyColor": "magenta"
        },
        {
            "type": "gpu",
            "key": "GPU       ",
            "keyColor": "blue"
        },
        {
            "type": "memory",
            "key": "MEMORY    ",
            "keyColor": "magenta"
        },
        {
            "type": "disk",
            "key": "DISK      ",
            "keyColor": "blue"
        },
        {
            "type": "localip",
            "key": "IP        ",
            "keyColor": "magenta"
        }
    ]
}
