#!/usr/bin/env bash
# colorChange [wallpaper]
#
# Read the wallpaper's dominant colour and recolour the desktop to match it:
# kitty, polybar, rofi, dunst and the cava/ff visualiser gradient.
# Called by `changer` and `wallpaper-selector` after the wallpaper is set.
set -euo pipefail
export PATH="$PATH:$HOME/.local/bin"

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/colorChange"
mkdir -p "$STATE_DIR"
# Serialize palette generation and publication when wallpapers change quickly.
exec 9> "$STATE_DIR/update.lock"
flock 9

# --------------------------------------------------------------- helpers ----
write_file() {
    local target="$1" temporary
    temporary="$(mktemp "${target}.XXXXXX")"
    if cat > "$temporary" && mv -f -- "$temporary" "$target"; then
        return 0
    fi
    rm -f -- "$temporary"
    return 1
}

hex2rgb() { local h="${1#\#}"; echo $((16#${h:0:2})) $((16#${h:2:2})) $((16#${h:4:2})); }
rgb2hex() { printf '#%02x%02x%02x' "$1" "$2" "$3"; }

mix() { # mix <a> <b> <percent of b>
    local r1 g1 b1 r2 g2 b2 p="${3:-50}"
    read -r r1 g1 b1 < <(hex2rgb "$1")
    read -r r2 g2 b2 < <(hex2rgb "$2")
    rgb2hex $(( (r1 * (100 - p) + r2 * p) / 100 )) \
            $(( (g1 * (100 - p) + g2 * p) / 100 )) \
            $(( (b1 * (100 - p) + b2 * p) / 100 ))
}
lighten() { mix "$1" "#ffffff" "${2:-25}"; }
darken()  { mix "$1" "#000000" "${2:-25}"; }

luma() {
    local r g b
    read -r r g b < <(hex2rgb "$1")
    echo $(( (r * 299 + g * 587 + b * 114) / 1000 ))
}

pick_accent() { # most saturated colour, brightest wins ties
    local c best="" bestsat=-1 bestlum=-1 r g b mx mn sat lum
    for c in "$@"; do
        [ -n "$c" ] || continue
        read -r r g b < <(hex2rgb "$c")
        mx=$r; (( g > mx )) && mx=$g; (( b > mx )) && mx=$b
        mn=$r; (( g < mn )) && mn=$g; (( b < mn )) && mn=$b
        sat=$(( mx - mn )); lum=$(( (mx + mn) / 2 ))
        if (( sat > bestsat || (sat == bestsat && lum > bestlum) )); then
            best="$c"; bestsat="$sat"; bestlum="$lum"
        fi
    done
    printf '%s' "${best:-#b03060}"
}

# -------------------------------------------------------------- wallpaper ----
wall="${1:-}"
if [ -z "$wall" ] && [ -f "$HOME/.fehbg" ] && command -v python3 >/dev/null 2>&1; then
    # Read feh's shell quoting without executing the saved command.
    wall="$(python3 - "$HOME/.fehbg" <<'PY'
import os
import shlex
import sys

with open(sys.argv[1]) as saved:
    for line in saved:
        try:
            words = shlex.split(line, comments=True)
        except ValueError:
            continue
        if words and os.path.basename(words[0]) == "feh":
            for word in words[1:]:
                if os.path.isfile(word):
                    print(word)
                    sys.exit(0)
PY
    )"
fi
[ -n "$wall" ] || wall="$(cat "$STATE_DIR/last-wallpaper" 2>/dev/null || true)"
if [ -z "$wall" ] || [ ! -f "$wall" ]; then
    echo "colorChange: no wallpaper to read (pass a path)" >&2
    exit 1
fi
wall="$(realpath -- "$wall")"

# ---------------------------------------------------------------- palette ----
declare -a P=()
WAL_CACHE_DIR="${PYWAL_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/wal}"
# Pywal's normal reload restarts bspwm and the bar before our files are ready.
# Generate the palette only; reload consumers after publishing all their files.
if command -v wal >/dev/null 2>&1 && wal -i "$wall" -n -q -s -t -e >/dev/null 2>&1; then
    if [ -s "$WAL_CACHE_DIR/colors" ]; then
        mapfile -t P < "$WAL_CACHE_DIR/colors"
        for color in "${P[@]}"; do
            if [[ ! "$color" =~ ^#[[:xdigit:]]{6}$ ]]; then
                P=()
                break
            fi
        done
    fi
fi

if [ "${#P[@]}" -lt 16 ]; then
    dom=""
    image_tool=""
    if command -v magick >/dev/null 2>&1; then
        image_tool=magick
    elif command -v convert >/dev/null 2>&1; then
        image_tool=convert
    fi
    if [ -n "$image_tool" ]; then
        # Force RGB8 output: truncating a 16-bit hex value gives the wrong hue.
        dom="$("$image_tool" "${wall}[0]" -resize 64x64 -alpha off -colors 8 -depth 8 \
            -format %c histogram:info: 2>/dev/null | sort -rn \
            | awk 'match($0, /#[0-9A-Fa-f]+/) { c=substr($0, RSTART, RLENGTH); if (length(c)==7) { print c; exit } }' || true)"
    fi
    if [[ ! "$dom" =~ ^#[[:xdigit:]]{6}$ ]]; then
        echo "colorChange: could not extract colours from $wall (install pywal or ImageMagick)" >&2
        exit 1
    fi
    P=("$(darken "$dom" 85)" "$dom" "$(mix "$dom" '#ffffff' 20)" "$(mix "$dom" '#ffffff' 40)"
       "$(mix "$dom" '#ffffff' 60)" "$dom" "$(lighten "$dom" 30)" "$(lighten "$dom" 70)"
       "$(darken "$dom" 40)" "$(lighten "$dom" 20)" "$(mix "$dom" '#ffffff' 15)"
       "$(mix "$dom" '#ffffff' 35)" "$(mix "$dom" '#ffffff' 55)" "$(lighten "$dom" 45)"
       "$(lighten "$dom" 80)" "#ffffff")
fi

BG="${P[0]}"
ACCENT="$(pick_accent "${P[@]}")"
[ "$(luma "$ACCENT")" -ge 150 ] || ACCENT="$(lighten "$ACCENT" 30)"
FG="$ACCENT"
FG_ALT="$(mix "$FG" "$BG" 45)"
BG_ALT="$(mix "$BG" "#ffffff" 10)"
SELECTED="$(darken "$ACCENT" 55)"

# ----------------------------------------------------------------- kitty ----
mkdir -p "$CONFIG_DIR/kitty"
{
    echo "# generated by colorChange from $(basename "$wall") -- do not edit"
    printf 'foreground            %s\n' "$FG"
    printf 'background            %s\n' "$BG"
    printf 'cursor                %s\n' "$ACCENT"
    printf 'cursor_text_color     %s\n' "$BG"
    printf 'selection_foreground  %s\n' "$BG"
    printf 'selection_background  %s\n' "$ACCENT"
    for i in $(seq 0 15); do
        printf 'color%-17s%s\n' "$i" "${P[$i]}"
    done
} | write_file "$CONFIG_DIR/kitty/theme.conf"
grep -q '^include theme.conf' "$CONFIG_DIR/kitty/kitty.conf" 2>/dev/null || \
    printf '\n# colours are managed by colorChange (see ~/.local/bin/colorChange)\ninclude theme.conf\n' \
        >> "$CONFIG_DIR/kitty/kitty.conf"

# --------------------------------------------------------------- polybar ----
mkdir -p "$CONFIG_DIR/polybar"
{
    echo "; generated by colorChange -- do not edit"
    echo "[colors]"
    printf ' bg = %s\n' "$BG"
    printf ' tp = %s\n' "$BG_ALT"
    printf ' trans = %s\n' "$ACCENT"
    printf ' fg = %s\n' "$FG"
    printf ' white = %s\n' "$(lighten "$ACCENT" 70)"
    printf ' fg-alt = %s\n' "$FG_ALT"
    printf ' foreground-alt = %s\n' "$FG_ALT"
    printf ' blue-s = %s\n' "$(lighten "$ACCENT" 50)"
    printf ' blue = %s\n' "$ACCENT"
    printf ' blue-alt = %s\n' "$(lighten "$ACCENT" 25)"
    printf ' red = %s\n' "$ACCENT"
    printf ' green = %s\n' "$ACCENT"
    printf ' yellow = %s\n' "$(lighten "$ACCENT" 15)"
    printf ' cyan = %s\n' "$ACCENT"
    printf ' magenta = %s\n' "$(lighten "$ACCENT" 10)"
    printf ' primary = %s\n' "$ACCENT"
    printf ' alert = %s\n' "$(lighten "$ACCENT" 20)"
} | write_file "$CONFIG_DIR/polybar/colors.ini"

# ------------------------------------------------------------------ rofi ----
mkdir -p "$CONFIG_DIR/rofi/colors"
{
    echo "/* generated by colorChange -- do not edit */"
    echo "* {"
    printf '    background:     %s;\n' "$BG"
    printf '    background-alt: %s;\n' "$BG_ALT"
    printf '    foreground:     %s;\n' "$FG"
    printf '    selected:       %s;\n' "$SELECTED"
    printf '    selected-fg:    %s;\n' "$FG"
    printf '    active:         %s;\n' "$ACCENT"
    printf '    urgent:         %s;\n' "$(lighten "$ACCENT" 15)"
    echo "}"
} | write_file "$CONFIG_DIR/rofi/colors/generated.rasi"
# Rofi imports ~/.local/share/rofi-themes/active.rasi, which theme-cycle
# points at generated.rasi in auto mode or at a chosen theme otherwise.

# ----------------------------------------------------------------- dunst ----
mkdir -p "$CONFIG_DIR/dunst/dunstrc.d"
{
    echo "# generated by colorChange -- do not edit"
    echo "[global]"
    printf '    frame_color = "%s"\n' "$ACCENT"
    printf '    foreground = "%s"\n' "$FG"
    echo
    echo "[urgency_low]"
    printf '    background = "%s"\n' "$BG"
    printf '    foreground = "%s"\n' "$FG_ALT"
    echo
    echo "[urgency_normal]"
    printf '    background = "%s"\n' "$BG_ALT"
    printf '    foreground = "%s"\n' "$FG"
    echo
    echo "[urgency_critical]"
    printf '    background = "%s"\n' "$(darken "$ACCENT" 65)"
    printf '    foreground = "%s"\n' "$FG"
    printf '    frame_color = "%s"\n' "$ACCENT"
} | write_file "$CONFIG_DIR/dunst/dunstrc.d/99-colorChange.conf"

# ------------------------------------------------- cava/ff bar gradient ------
printf '%s %s %s %s\n' \
    "$ACCENT" \
    "$(mix "$ACCENT" '#ffffff' 30)" \
    "$(mix "$ACCENT" '#ffffff' 55)" \
    "$(mix "$ACCENT" '#ffffff' 80)" | write_file "$STATE_DIR/gradient"
printf '%s\n' "$wall" | write_file "$STATE_DIR/last-wallpaper"

# SIGUSR1 makes Polybar reread config.ini and its colour include in place.
# Avoid kill/wait/launch races and refresh only after every theme is complete.
pkill -USR1 -u "$UID" -x polybar 2>/dev/null || true
pkill -USR1 -u "$UID" -x kitty 2>/dev/null || true
if command -v dunstctl >/dev/null 2>&1 && pgrep -u "$UID" -x dunst >/dev/null; then
    dunstctl reload >/dev/null 2>&1 || true
fi

echo "colorChange: $(basename "$wall") -> $ACCENT (bg $BG)"
