#!/usr/bin/env bash
# Wrapper for feh: setting a wallpaper also refreshes the desktop palette.
# ~/.local/bin comes before /usr/bin in PATH, so this shadows the real feh.
set -u

/usr/bin/feh "$@"
status=$?

if [ "$status" -ne 0 ] || [ -n "${FEH_SKIP_COLORCHANGE:-}" ]; then
    exit "$status"
fi

image=""
wallpaper=""
for arg in "$@"; do
    case "$arg" in
        --bg-fill|--bg-max|--bg-scale|--bg-tile|--bg-center) wallpaper=1 ;;
        --*) ;;
        -*) ;;
        *) image="$arg" ;;
    esac
done

if [ -n "$wallpaper" ]; then
    colorchange="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/colorChange"
    if [ -n "$image" ] && [ -f "$image" ]; then
        "$colorchange" "$image" >/dev/null
    else
        "$colorchange" >/dev/null
    fi
fi

exit "$status"
