#!/usr/bin/env bash
# Toggle bspwm between the gapped (borderless) and bordered look.
# Bound to super+alt+b / ctrl+alt+b.
set -u

state="${XDG_CACHE_HOME:-$HOME/.cache}/bspwm-borders"

if [ -f "$state" ]; then
    bspc config border_width 0
    bspc config window_gap 12
    rm -f "$state"
else
    bspc config border_width 2
    bspc config window_gap 6
    mkdir -p "$(dirname "$state")"
    touch "$state"
fi
