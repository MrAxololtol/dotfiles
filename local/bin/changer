#!/usr/bin/env bash
# Pick a random wallpaper and refresh the desktop palette.
# Bound to super+alt+w / ctrl+alt+w.
set -euo pipefail

WALL_DIR="${WALL_DIR:-$HOME/Pictures/Wallpapers}"
mapfile -d '' -t WALLS < <(find "$WALL_DIR" -maxdepth 1 -type f \
    \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) -print0 | sort -z)

if [ "${#WALLS[@]}" -eq 0 ]; then
    echo "changer: no wallpapers in $WALL_DIR" >&2
    exit 1
fi

wall="${WALLS[RANDOM % ${#WALLS[@]}]}"
exec "$(dirname -- "${BASH_SOURCE[0]}")/set-wallpaper" "$wall"
