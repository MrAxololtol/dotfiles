#!/usr/bin/env bash
# Pick a random wallpaper, set it with feh and refresh the pywal palette.
# Bound to super+alt+w / ctrl+alt+w.
set -u

WALL_DIR="${WALL_DIR:-$HOME/Pictures/Wallpapers}"
mapfile -t WALLS < <(find "$WALL_DIR" -maxdepth 1 -type f \
    \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \) | sort)

if [ "${#WALLS[@]}" -eq 0 ]; then
    echo "changer: no wallpapers in $WALL_DIR" >&2
    exit 1
fi

wall="${WALLS[RANDOM % ${#WALLS[@]}]}"
feh --no-fehbg --bg-fill "$wall"

# Recolour the desktop to match the new wallpaper.
if command -v colorChange >/dev/null 2>&1; then
    colorChange "$wall"
fi
