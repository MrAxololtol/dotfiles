#!/usr/bin/env bash
# rofi power menu. Bound to super+q / alt+q.
set -u

entries="Lock\nLogout\nSuspend\nReboot\nShutdown"
choice="$(printf '%b\n' "$entries" | rofi -dmenu -i -p 'Power')"
[ -n "$choice" ] || exit 0

case "$choice" in
    Lock)     i3lock-fancy ;;
    Logout)   bspc quit ;;
    Suspend)  systemctl suspend ;;
    Reboot)   systemctl reboot ;;
    Shutdown) systemctl poweroff ;;
esac
